{
    "name": "moheyelbaz/zatca-qr",
    "description": "Saudi Arabia ZATCA e-invoicing (Fatoora) toolkit in PHP: Phase 1 TLV QR codes, and Phase 2 EGS onboarding, invoice signing and reporting. Maintained fork of Nady Shalaby's PHP port of wes4m/zatca-xml-js.",
    "type": "library",
    "license": "MIT",
    "keywords": ["zatca", "fatoora", "e-invoicing", "saudi-arabia", "qr-code", "tlv", "ubl", "vat", "phase-2"],
    "homepage": "https://github.com/MoheyElbaz/zatca-qr",
    "authors": [
        { "name": "Mohey Elbaz", "role": "Maintainer of this fork" },
        { "name": "Nady Shalaby", "role": "Author of the PHP port" },
        { "name": "Wesam Alzahir (wes4m)", "role": "Author of the original zatca-xml-js" }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "endroid/qr-code": "^5.0"
    },
    "suggest": {
        "endroid/qr-code": "Only needed to render the TLV payload as a QR image; the library itself returns the Base64 TLV string (^5.0)"
    },
    "autoload": {
        "psr-4": {
            "ZATCA\\": "ZATCA/"
        }
    },
    "scripts": {
        "test": "php tests/run.php"
    },
    "minimum-stability": "stable"
}
